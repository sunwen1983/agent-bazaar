{
  "brand": "Flights",
  "networks": [
    {
      "name": "flights",
      "front_man": "flights_agent",
      "hocon": "./flights.network.json",
      "description": "Searches round-trip flights to Austin and returns comparable options with prices.",
      "tags": [
        "deployed",
        "nsdeploy"
      ],
      "sample_queries": [
        "Find round-trip flights from San Francisco to Austin for next Friday to Sunday, 2 adults, economy, under $400 total."
      ]
    }
  ],
  "llm_router": {
    "base_url": "https://api.openai.com/v1",
    "mock": false,
    "byok_router": "https://api.openai.com/v1"
  },
  "allowed_peers": [
    "https://agent-bazaar-flights.pages.dev"
  ],
  "peer_policy": {
    "mode": "open",
    "deny_origins": [],
    "note": "Public agent sites are reachable like web pages; credentials and capabilities do not transfer."
  },
  "agent_mcp": {
    "protocol": "nsdeploy-agent-mcp/v1",
    "network": "flights",
    "front_man": "flights_agent",
    "available": false,
    "reason": "This is a static bundle; a public MCP facade requires an application host."
  },
  "theme": {
    "primary": "#0ea5e9"
  },
  "linking": {
    "protocol": "nsdeploy-link/v1",
    "exports": [
      {
        "network": "flights",
        "front_man": "flights_agent",
        "aliases": [
          "flights",
          "flights_agent"
        ],
        "url": "https://agent-bazaar-flights.pages.dev/flights"
      }
    ],
    "imports": [],
    "site": "https://agent-bazaar-flights.pages.dev",
    "link_updates": {
      "mode": "browser-local"
    }
  },
  "deployment": {
    "mode": "static",
    "self_contained_runtime": true,
    "browser_mock": false,
    "direct_byok": true,
    "direct_mcp_requires_cors": true,
    "public_mcp_facade": false
  }
}